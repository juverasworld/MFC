VITE_API_BASE_URL=https://apime.myfamilycompanion.org/api/v1
# Optional payment API base. If empty, checkout uses this app's same-origin /api routes.
VITE_PAYMENT_API_BASE_URL=
# Browser-safe Paystack public key. Use a matching test key for local testing.
VITE_PAYSTACK_PUBLIC_KEY=
VITE_AMAZON_LINK=
# Server-side only: configure in the hosting provider, never expose with a VITE_ prefix.
PAYSTACK_SECRET_KEY=
APP_BASE_URL=https://myfamilycompanion.org
MFC_API_BASE_URL=
# Exact MFC backend endpoint that creates/activates an advocate after verified payment.
MFC_PROMOTER_REGISTRATION_URL=
# Server-to-server bearer credential for the MFC order/registration API.
MFC_FULFILLMENT_TOKEN=
